# Base image with ROCm support
FROM rocm/pytorch:rocm6.4.1_ubuntu22.04_py3.10_pytorch_release_2.6.0

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    build-essential \
    libsndfile1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables
ENV PATH="/opt/rocm/bin:${PATH}" \
    HSA_OVERRIDE_GFX_VERSION=11.0.0 \
    AMD_SERIALIZE_KERNEL=1 \
    PYTORCH_HIP_ALLOC_CONF=max_split_size_mb:128 \
    HIP_VISIBLE_DEVICES=0 \
    WHISPER_MODEL=small

# Create app directory
WORKDIR /app

# Copy requirements
COPY requirements_amd.txt .

# Install Python dependencies
RUN pip3 install --no-cache-dir -r requirements_amd.txt

# Copy app files
COPY . .

# Expose port
EXPOSE 8000

WORKDIR /app/deps/exo
RUN ./install.sh

WORKDIR /app

# Run the application
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]