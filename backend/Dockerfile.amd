# Base image with ROCm support
FROM ubuntu:22.04 as base

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    build-essential \
    wget \
    git \
    libsndfile1 \
    curl \
    software-properties-common \
    gnupg \
    cmake \
    ninja-build \
    pkg-config \
    libssl-dev \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Install ROCm
RUN wget -q -O - https://repo.radeon.com/rocm/rocm-sigkey.gpg | apt-key add - \
    && echo 'deb [arch=amd64] https://repo.radeon.com/rocm/apt/5.4/ ubuntu main' | tee /etc/apt/sources.list.d/rocm.list \
    && apt-get update && apt-get install -y \
    rocm-libs \
    rocm-dev \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables
ENV PATH="/opt/rocm/bin:${PATH}" \
    HSA_OVERRIDE_GFX_VERSION=10.3.0 \
    AMD_SERIALIZE_KERNEL=3 \
    PYTORCH_HIP_ALLOC_CONF=max_split_size_mb:128 \
    HIP_VISIBLE_DEVICES=0 \
    WHISPER_MODEL=small \
    NANOCHAT_BASE_DIR="/app/cache/nanochat" \
    OMP_NUM_THREADS=1 \
    WANDB_RUN=dummy

# Create app directory
WORKDIR /app

# Copy requirements and scripts
COPY requirements_unified.txt .
COPY install_pytorch_rocm.sh .

# Install Rust for nanochat tokenizer
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Install uv for dependency management
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

# Install PyTorch with ROCm support first
RUN pip3 install --no-cache-dir torch>=2.8.0 --index-url https://download.pytorch.org/whl/rocm5.6

# Install unified Python dependencies
RUN pip3 install --no-cache-dir -r requirements_unified.txt

# Copy app files
COPY . .

# Expose port
EXPOSE 8000

# Run the application
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"] 